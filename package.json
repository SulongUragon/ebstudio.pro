{
  "name": "eb-studio-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:exports && npm run build && node --test tests/rendered-html.test.mjs",
    "test:exports": "node --import tsx --test tests/exporters-kdp.test.ts tests/cover-title.test.ts tests/visual-book-utils.test.ts",
    "validate:epub": "python3 scripts/validate-epub.py",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "EB Studio Pro"
}
